{
  "name": "photografik-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Photografik Studios website. Zero-dependency static build with JSON content.",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "node src/build.mjs",
    "build:production": "SITE_MODE=production node src/build.mjs",
    "serve": "node tests/serve.mjs",
    "test": "node --test tests/pricing.test.mjs tests/gallery.test.mjs",
    "test:e2e": "node tests/e2e.mjs"
  }
}
